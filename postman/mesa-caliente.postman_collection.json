 "item": [
  {
   "name": "1. Setup",
   "item": [
    {
     "name": "Crear insumo Carne (stock 100)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/inventario/productos",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"nombre\": \"Carne E2E\",\n  \"stockInicial\": 100\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('201', () => pm.response.to.have.status(201));",
         "pm.collectionVariables.set('carneId', pm.response.json().id);",
         "pm.test('stock 100', () => pm.expect(pm.response.json().stock).to.eql(100));"
        ]
       }
      }
     ]
    },
    {
     "name": "Crear insumo Pan (stock 100)",
     "request": {
      "method": "POST",
      "header": [
