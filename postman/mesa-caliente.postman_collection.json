        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": "{{baseUrl}}/carta/platos/{{platoId}}/receta",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"receta\": [\n    { \"insumoId\": \"{{carneId}}\", \"cantidad\": 2 },\n    { \"insumoId\": \"{{panId}}\", \"cantidad\": 1 }\n  ]\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('ok', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));"
        ]
       }
      }
     ]
    },
    {
     "name": "Crear mesa",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
