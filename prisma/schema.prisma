generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Los modelos de cada Bounded Context se agregan en su fase correspondiente
// (ver PLAN-FASES-DESARROLLO.md). El patron Outbox se agrega en la Fase 8.

// Convencion de moneda: los montos (COP) se persisten como Int (pesos enteros),
// consistente en todo el proyecto. Mapea al VO Dinero { monto: number, moneda: 'COP' }.

enum EstadoPedidoDb {
  BORRADOR
  CONFIRMADO
  EN_PREPARACION
  LISTO
  PAGADO
  CANCELADO
}

model Pedido {
  id         String         @id @default(uuid())
  mesaId     String?
  tipo       String
  estado     EstadoPedidoDb
  createdAt  DateTime       @default(now())
  calle      String?
  ciudad     String?
  referencia String?
  items      ItemPedido[]
}

model ItemPedido {
  id             String @id @default(uuid())
  pedidoId       String
  pedido         Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String
  cantidad       Int
  precioUnitario Int
}

enum EstadoMesaDb {
  LIBRE
  OCUPADA
}

model Mesa {
  id     String       @id @default(uuid())
  numero Int          @unique
  estado EstadoMesaDb
}

enum EstadoOrdenCocinaDb {
  PENDIENTE
  EN_PREPARACION
  LISTA
  DESCARTADA
}

model OrdenCocina {
  id       String              @id @default(uuid())
  pedidoId String
  estado   EstadoOrdenCocinaDb
  items    ItemOrden[]
}

model ItemOrden {
  id         String      @id @default(uuid())
  ordenId    String
  orden      OrdenCocina @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  productoId String
  cantidad   Int
  preparado  Boolean     @default(false)
}

model Producto {
  id             String @id @default(uuid())
  nombre         String
  stock          Int
  stockReservado Int    @default(0)
}

enum CategoriaPlatoDb {
  ENTRADA
  PRINCIPAL
  POSTRE
  BEBIDA
  ACOMPANAMIENTO
}

model Plato {
  id         String           @id @default(uuid())
  nombre     String
  precio     Int
  categoria  CategoriaPlatoDb
  disponible Boolean          @default(true)
  receta     LineaReceta[]
}

model LineaReceta {
  id       String @id @default(uuid())
  platoId  String
  plato    Plato  @relation(fields: [platoId], references: [id], onDelete: Cascade)
  insumoId String
  cantidad Int
}

enum EstadoCuentaDb {
  ABIERTA
  PAGADA
}

model Cuenta {
  id     String         @id @default(uuid())
  mesaId String?
  estado EstadoCuentaDb
  lineas LineaCuenta[]
}

model LineaCuenta {
  id       String @id @default(uuid())
  cuentaId String
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  pedidoId String
  total    Int
}

enum EstadoDomicilioDb {
  ASIGNADO
  EN_CAMINO
  ENTREGADO
}

model Domicilio {
  id         String            @id @default(uuid())
  pedidoId   String
  calle      String
  ciudad     String
  referencia String?
  estado     EstadoDomicilioDb
}

// Proyeccion (read-model) del catalogo de Carta, mantenida por Pedidos via
// eventos, para resolver precio/disponibilidad al agregar un plato al pedido.
model PlatoCatalogo {
  platoId    String  @id
  nombre     String
  precio     Int
  disponible Boolean
}

model OutboxEvent {
  id          String   @id @default(uuid())
  aggregateId String
  eventType   String
  payload     Json
  createdAt   DateTime @default(now())
  publicado   Boolean  @default(false)

  @@index([publicado, createdAt])
}
